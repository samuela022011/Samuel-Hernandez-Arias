# Lists (Data Abstraction)
assignment_names = []
assignment_subjects = []
assignment_days_left = []
assignment_difficulties = []
assignment_completed = []
# --------------------------
# Function 1
# Adds a new assignment
# --------------------------
def add_assignment(name, subject, days_left, difficulty):
    assignment_names.append(name)
    assignment_subjects.append(subject)
    assignment_days_left.append(days_left)
    assignment_difficulties.append(difficulty)
    assignment_completed.append(False)
# --------------------------
# Function 2
# Calculates priority
# --------------------------
def calculate_priority(days_left, difficulty):

    if days_left <= 2 or difficulty >= 4:
        return "High"

    elif days_left <= 5:
        return "Medium"

    else:
        return "Low"
# --------------------------
# Function 3
# Algorithm
# Contains iteration and selection
# --------------------------
def generate_study_plan():

    print("\n===== STUDY PLAN =====")

    active_found = False

    for i in range(len(assignment_names)):      # Iteration

        if assignment_completed[i] == False:    # Selection

            priority = calculate_priority(
                assignment_days_left[i],
                assignment_difficulties[i]
            )

            print(
                f"{i + 1}. {assignment_names[i]}"
                f" | Subject: {assignment_subjects[i]}"
                f" | Due in: {assignment_days_left[i]} days"
                f" | Priority: {priority}"
            )

            active_found = True

    if active_found == False:
        print("No active assignments.")
# --------------------------
# Function 4
# Marks assignment complete
# --------------------------
def mark_complete(index):

    if 0 <= index < len(assignment_completed):

        assignment_completed[index] = True
        print("Assignment marked complete!")

    else:
        print("Invalid assignment number.")
# --------------------------
# Function 5
# Displays statistics
# --------------------------
def display_stats():

    total = len(assignment_names)

    completed = 0

    for status in assignment_completed:

        if status == True:
            completed += 1

    print("\n===== STATISTICS =====")
    print("Total Assignments:", total)
    print("Completed:", completed)
    print("Remaining:", total - completed)
# --------------------------
# Main Program
# --------------------------

running = True

print("Welcome to StudySync!")

while running:

    print("\n==========================")
    print("      STUDYSYNC MENU")
    print("==========================")
    print("1. Add Assignment")
    print("2. View Study Plan")
    print("3. Mark Assignment Complete")
    print("4. View Statistics")
    print("5. Exit")

    choice = input("\nChoose an option: ")

    # Add Assignment
    if choice == "1":

        name = input("Assignment Name: ")

        subject = input("Subject: ")

        days_left = int(
            input("Days Until Due Date: ")
        )

        difficulty = int(
            input("Difficulty (1-5): ")
        )

        add_assignment(
            name,
            subject,
            days_left,
            difficulty
        )

        print("Assignment added successfully!")

    # View Plan
    elif choice == "2":

        generate_study_plan()

    # Complete Assignment
    elif choice == "3":

        generate_study_plan()

        if len(assignment_names) > 0:

            assignment_number = int(
                input(
                    "\nEnter assignment number to mark complete: "
                )
            )

            mark_complete(assignment_number - 1)

    # Statistics
    elif choice == "4":

        display_stats()

    # Exit
    elif choice == "5":

        running = False
        print("Thank you for using StudySync!")

    else:

        print("Invalid option. Please try again.")
